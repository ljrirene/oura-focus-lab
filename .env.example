# Oura OAuth application credentials.
# Register an app at https://cloud.ouraring.com/oauth/applications
# and set the redirect URI to http://localhost:8765/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:8765/callback
# Optional. Leave blank to use the default scopes in scripts/oura_sync.py.
# OURA_SCOPES=personal daily heartrate tag workout session spo2 ring_configuration stress heart_health

# Required before exposing the app through a tunnel or binding beyond localhost.
# OURA_APP_USERNAME=oura
# OURA_APP_PASSWORD=replace-with-a-long-random-password
